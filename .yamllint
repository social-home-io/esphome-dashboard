extends: default

ignore: |
  .venv/
  .esphome/
  **/.esphome/
  build/

rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
